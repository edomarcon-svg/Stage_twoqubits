# Copy to archive.env on the server, chmod 600 archive.env, and fill in locally.
# Keep the bucket PRIVATE. Example endpoint for a bucket in Hetzner fsn1:
QOC_ARCHIVE_BUCKET=""
QOC_ARCHIVE_ENDPOINT="https://fsn1.your-objectstorage.com"
AWS_DEFAULT_REGION="fsn1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
# For AWS itself, leave QOC_ARCHIVE_ENDPOINT empty and set the actual AWS region.
QOC_ARCHIVE_ADDRESSING_STYLE="auto"
QOC_ARCHIVE_PREFIX="twoqubits"
QOC_ARCHIVE_LINK_SECONDS="604800"

EMAIL_TO=""
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"

# Absolute Python path in the simulation environment on your server.
QOC_PYTHON="/root/stage_env/bin/python"
QOC_RUN_MODE="campaign"
# Optional overrides, otherwise the script chooses configurazione_campagna.jsonc.
# QOC_CONFIG="/root/Stage_twoqubits/v2/configurazione_campagna.jsonc"
# QOC_RESUME="/root/Stage_twoqubits/v2/results/campagna_fock_completa_TIMESTAMP"
QOC_NO_PLOTS="false"

# Opt-in: deletion happens ONLY after full remote readback + SHA-256 + SMTP success.
DELETE_SERVER_AFTER_DELIVERY="false"
HCLOUD_TOKEN=""
