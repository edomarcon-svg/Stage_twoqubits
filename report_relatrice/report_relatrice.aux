\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Dinamica temporale della probabilità target $P_{|n=6\rangle }(t)$ (in alto) e del numero medio di fotoni $\langle n \rangle (t)$ (in basso) per Fock $|n=6\rangle $ a durata dimezzata $T = 10\,\tau _s$ (\texttt  {main\_006}). Mentre \texttt  {1q} e \texttt  {2q\_normalized\_independent} non riescono a pompare in media i 6 fotoni entro $10\,\tau _s$, sia \texttt  {2q\_common} sia \texttt  {2q\_independent} raggiungono $P > 0.99998$ a $t=T$. Dopo $t=10\,\tau _s$ (linea tratteggiata verticale) è visibile la fase di \texttt  {hold\_time} a comando spento, in cui lo stato scambia energia con i qubit a causa dell'accoppiamento $g$ sempre attivo.}}{9}{figure.caption.14}\protected@file@percent }
\newlabel{fig:dinamica_fock6_t10}{{6}{9}{Dinamica temporale della probabilità target $P_{|n=6\rangle }(t)$ (in alto) e del numero medio di fotoni $\langle n \rangle (t)$ (in basso) per Fock $|n=6\rangle $ a durata dimezzata $T = 10\,\tau _s$ (\texttt {main\_006}). Mentre \texttt {1q} e \texttt {2q\_normalized\_independent} non riescono a pompare in media i 6 fotoni entro $10\,\tau _s$, sia \texttt {2q\_common} sia \texttt {2q\_independent} raggiungono $P > 0.99998$ a $t=T$. Dopo $t=10\,\tau _s$ (linea tratteggiata verticale) è visibile la fase di \texttt {hold\_time} a comando spento, in cui lo stato scambia energia con i qubit a causa dell'accoppiamento $g$ sempre attivo}{figure.caption.14}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Confronto su Fock $|n=10\rangle $ a $T = 10\,\tau _s$ tra il blocco con filtro causale $\omega _{\text  {cut}}=3.0$ (\texttt  {main\_008}, barre piene) e il blocco diagnostico senza filtro (\texttt  {main\_010}, barre tratteggiate). Togliendo il filtro, \texttt  {2q\_independent} passa da 0/8 a 8/8 seed validati sopra soglia ($P_{\text  {mediana}} = 0.999937$), mentre \texttt  {1q} e i casi \texttt  {2q\_normalized} restano sotto $0.83$ anche senza filtro.}}{10}{figure.caption.15}\protected@file@percent }
\newlabel{fig:filtro_vs_nofiltro}{{7}{10}{Confronto su Fock $|n=10\rangle $ a $T = 10\,\tau _s$ tra il blocco con filtro causale $\omega _{\text {cut}}=3.0$ (\texttt {main\_008}, barre piene) e il blocco diagnostico senza filtro (\texttt {main\_010}, barre tratteggiate). Togliendo il filtro, \texttt {2q\_independent} passa da 0/8 a 8/8 seed validati sopra soglia ($P_{\text {mediana}} = 0.999937$), mentre \texttt {1q} e i casi \texttt {2q\_normalized} restano sotto $0.83$ anche senza filtro}{figure.caption.15}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Funzioni di Wigner (target vs stato finale preparato) per Fock $|n=10\rangle $ a $T=20\,\tau _s$ con filtro $\omega _{\text  {cut}}=3.0$ (\texttt  {main\_009}): usando l'obiettivo \texttt  {root} e portando lo spazio a $\text  {dim}=60$, sia il singolo qubit sia i due qubit riproducono i 10 anelli concentrici con precisione certificata.}}{10}{figure.caption.16}\protected@file@percent }
\newlabel{fig:wigner_main009}{{8}{10}{Funzioni di Wigner (target vs stato finale preparato) per Fock $|n=10\rangle $ a $T=20\,\tau _s$ con filtro $\omega _{\text {cut}}=3.0$ (\texttt {main\_009}): usando l'obiettivo \texttt {root} e portando lo spazio a $\text {dim}=60$, sia il singolo qubit sia i due qubit riproducono i 10 anelli concentrici con precisione certificata}{figure.caption.16}{}}
