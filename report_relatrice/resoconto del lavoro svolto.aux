\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Panoramica dei 6 blocchi principali con filtro causale ($\omega _{\text  {cut}}=3.0$): probabilità target continua $P_{\text  {target}}$ (mediana e intervallo interquartile su 8 seed) a durata breve $T=10\,\tau _s$ (\texttt  {main\_004}, \texttt  {main\_006}, \texttt  {main\_008}, a sinistra) e a durata standard $T=20\,\tau _s$ (\texttt  {main\_005}, \texttt  {main\_007}, \texttt  {main\_009}, a destra).}}{8}{figure.caption.12}\protected@file@percent }
