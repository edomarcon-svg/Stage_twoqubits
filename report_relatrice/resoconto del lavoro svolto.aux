\newlabel{fig:panoramica_campagna}{{5}{8}{Panoramica dei 6 blocchi principali con filtro causale ($\omega _{\text {cut}}=3.0$): probabilità target continua $P_{\text {target}}$ (mediana e intervallo interquartile su 8 seed) a durata breve $T=10\,\tau _s$ (\texttt {main\_004}, \texttt {main\_006}, \texttt {main\_008}, a sinistra) e a durata standard $T=20\,\tau _s$ (\texttt {main\_005}, \texttt {main\_007}, \texttt {main\_009}, a destra)}{figure.caption.12}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Risultati completi della campagna v2 su tutti gli 8 blocchi principali (\texttt  {main\_004}--\texttt  {main\_011}). I valori di fluenza di modulazione $\mathcal  {F}_{\text  {mod}}$, costo del paper $C_2/\omega _c^2 = \mathcal  {F}_{\text  {mod}}/2$, slew rate massimo $\text  {SR}_{\max }$ e banda al 99\% $\omega _{99\%}$ sono le mediane sugli 8 seed (con il valore del seed selezionato indicato nell'ultima colonna).}}{8}{table.caption.13}\protected@file@percent }
\newlabel{tab:risultati_campagna}{{1}{8}{Risultati completi della campagna v2 su tutti gli 8 blocchi principali (\texttt {main\_004}--\texttt {main\_011}). I valori di fluenza di modulazione $\mathcal {F}_{\text {mod}}$, costo del paper $C_2/\omega _c^2 = \mathcal {F}_{\text {mod}}/2$, slew rate massimo $\text {SR}_{\max }$ e banda al 99\% $\omega _{99\%}$ sono le mediane sugli 8 seed (con il valore del seed selezionato indicato nell'ultima colonna)}{table.caption.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Dinamica temporale della probabilità target $P_{|n=6\rangle }(t)$ (in alto) e del numero medio di fotoni $\langle n \rangle (t)$ (in basso) per Fock $|n=6\rangle $ a durata dimezzata $T = 10\,\tau _s$ (\texttt  {main\_006}). è visibile la fase di \texttt  {hold\_time} a comando spento, in cui lo stato scambia energia con i qubit a causa dell'accoppiamento $g$ sempre attivo.}}{9}{figure.caption.15}\protected@file@percent }
\newlabel{fig:dinamica_fock6_t10}{{6}{9}{Dinamica temporale della probabilità target $P_{|n=6\rangle }(t)$ (in alto) e del numero medio di fotoni $\langle n \rangle (t)$ (in basso) per Fock $|n=6\rangle $ a durata dimezzata $T = 10\,\tau _s$ (\texttt {main\_006}). è visibile la fase di \texttt {hold\_time} a comando spento, in cui lo stato scambia energia con i qubit a causa dell'accoppiamento $g$ sempre attivo}{figure.caption.15}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Confronto su Fock $|n=10\rangle $ a $T = 10\,\tau _s$ tra il blocco con filtro causale $\omega _{\text  {cut}}=3.0$ (\texttt  {main\_008}, barre piene) e il blocco senza filtro (\texttt  {main\_010}, barre tratteggiate). Togliendo il filtro, \texttt  {2q\_independent} passa da 0/8 a 8/8 seed validati sopra soglia ($P_{\text  {mediana}} = 0.999937$), mentre \texttt  {1q} e i casi \texttt  {2q\_normalized} restano sotto $0.83$ anche senza filtro.}}{10}{figure.caption.16}\protected@file@percent }
\newlabel{fig:filtro_vs_nofiltro}{{7}{10}{Confronto su Fock $|n=10\rangle $ a $T = 10\,\tau _s$ tra il blocco con filtro causale $\omega _{\text {cut}}=3.0$ (\texttt {main\_008}, barre piene) e il blocco senza filtro (\texttt {main\_010}, barre tratteggiate). Togliendo il filtro, \texttt {2q\_independent} passa da 0/8 a 8/8 seed validati sopra soglia ($P_{\text {mediana}} = 0.999937$), mentre \texttt {1q} e i casi \texttt {2q\_normalized} restano sotto $0.83$ anche senza filtro}{figure.caption.16}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Effetto del filtro causale ($\omega _{\text  {cut}}=3.0\,\omega _c$) su Fock $|n=10\rangle $ per \texttt  {2q\_independent}: (a) profilo temporale della modulazione applicata $\Omega _{D,1}(t)$ nei primi $5\,\tau _s$ con e senza filtro; (b) frazione cumulativa della potenza spettrale AC in funzione della frequenza $\omega /\omega _c$, che illustra la riduzione della banda al 99\% ($\omega _{99\%}$) da $\sim 8\,\omega _c$ a $\sim 4.4\text  {--}5.5\,\omega _c$.}}{11}{figure.caption.17}\protected@file@percent }
\newlabel{fig:spettro_filtro}{{8}{11}{Effetto del filtro causale ($\omega _{\text {cut}}=3.0\,\omega _c$) su Fock $|n=10\rangle $ per \texttt {2q\_independent}: (a) profilo temporale della modulazione applicata $\Omega _{D,1}(t)$ nei primi $5\,\tau _s$ con e senza filtro; (b) frazione cumulativa della potenza spettrale AC in funzione della frequenza $\omega /\omega _c$, che illustra la riduzione della banda al 99\% ($\omega _{99\%}$) da $\sim 8\,\omega _c$ a $\sim 4.4\text {--}5.5\,\omega _c$}{figure.caption.17}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Scaling del costo energetico di controllo $C_2/\omega _c^2$ (Eq.~4 del paper, mediana e quartili su 8 seed) a $T = 20\,\tau _s$ con filtro $\omega _{\text  {cut}}=3.0$ (\texttt  {main\_005}, \texttt  {main\_007}, \texttt  {main\_009}): (a) costo totale del sistema $C_{2,\text  {tot}}$ sommato sui canali; (b) costo massimo per singolo canale $C_{2,\text  {max ch}}$. Il caso \texttt  {2q\_independent} mantiene lo stesso costo totale di \texttt  {1q} ma dimezza quasi il carico per singolo canale.}}{11}{figure.caption.18}\protected@file@percent }
\newlabel{fig:scaling_costo_C2}{{9}{11}{Scaling del costo energetico di controllo $C_2/\omega _c^2$ (Eq.~4 del paper, mediana e quartili su 8 seed) a $T = 20\,\tau _s$ con filtro $\omega _{\text {cut}}=3.0$ (\texttt {main\_005}, \texttt {main\_007}, \texttt {main\_009}): (a) costo totale del sistema $C_{2,\text {tot}}$ sommato sui canali; (b) costo massimo per singolo canale $C_{2,\text {max ch}}$. Il caso \texttt {2q\_independent} mantiene lo stesso costo totale di \texttt {1q} ma dimezza quasi il carico per singolo canale}{figure.caption.18}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Meccanismo fisico interno durante la preparazione di Fock $|n=10\rangle $ a $T=10\,\tau _s$ (\texttt  {main\_010}): popolazione del tripletto luminoso $|B\rangle $ e del singoletto dark $|D\rangle $, attivo solo in \texttt  {2q\_independent}.}}{12}{figure.caption.19}\protected@file@percent }
\newlabel{fig:meccanismo_dicke}{{10}{12}{Meccanismo fisico interno durante la preparazione di Fock $|n=10\rangle $ a $T=10\,\tau _s$ (\texttt {main\_010}): popolazione del tripletto luminoso $|B\rangle $ e del singoletto dark $|D\rangle $, attivo solo in \texttt {2q\_independent}}{figure.caption.19}{}}
