// Campagna sui vincoli dell'attuatore (banda filtro, escursione di ampiezza, slew rate)
// e sullo stato iniziale vestito ("ground" vs "bare"):
// 44 esperimenti principali (1056 pipeline: 3 sistemi fisici [1q, 2q_common, 2q_independent] x 8 seed),
// pilot disattivato (usa direttamente il profilo ottimale root + crab_initial_std=0.1).
//
// I casi normalizzati (2q_normalized_*) sono omessi in questa fase poiché il ruolo di g_eff
// è già stato isolato nelle due campagne precedenti.
//
// Struttura dei 4 studi:
// 1. Scansione sulla frequenza di taglio del filtro (filter_cutoff) per Fock |6> (10*tau_s),
//    Fock |10> (10 e 15*tau_s) e Cat alpha=2.0 (10*tau_s), completando i punti tra 1.0*omega_c e null.
// 2. Restrizione dell'escursione di frequenza (total_frequency_bounds: [1.0, 3.0], [1.25, 2.75], [1.5, 2.5])
//    attorno a omega_q = 2.0*omega_c con filtro 3.0*omega_c.
// 3. Regolarizzazione e vincolo rigido sullo slew rate (slew_weight in {1e-4, 5e-4, 2e-3} e max_slew in {2.5, 1.5})
//    su Fock |6> (10*tau_s) e Fock |10> (15*tau_s).
// 4. Analisi dello stato iniziale vestito ("initial_state": "ground", vero stato fondamentale USC dell'Hamiltoniana
//    di Rabi a drive spento) su Fock |6> (10, 20*tau_s), Fock |10> (10, 15, 20*tau_s) e Cat alpha=2.0 (10, 15*tau_s).
//
// Avvio dalla radice del progetto:
// .venv/bin/python v2/run_campaign.py --config v2/configurazione_campagna.jsonc --validate-config
// .venv/bin/python -u v2/run_campaign.py --config v2/configurazione_campagna.jsonc
{
  "name": "campagna_vincoli_filtro_ampiezza_slew_ground",
  "base": {
    "name": "constraints_and_ground_campaign_base",
    "dimension": 60,
    "intervals": 2000,
    "cases": [
      {
        "name": "1q",
        "couplings": [
          0.3
        ],
        "qubit_frequencies": [
          2.0
        ],
        "control": "independent"
      },
      {
        "name": "2q_common",
        "couplings": [
          0.3,
          0.3
        ],
        "qubit_frequencies": [
          2.0,
          2.0
        ],
        "control": "common"
      },
      {
        "name": "2q_independent",
        "couplings": [
          0.3,
          0.3
        ],
        "qubit_frequencies": [
          2.0,
          2.0
        ],
        "control": "independent"
      }
    ],
    "target": {
      "kind": "fock",
      "value": 10
    },
    "control": {
      "nodes": 201,
      "filter_cutoff": 3.0,
      "total_frequency_bounds": [
        0.5,
        3.0
      ],
      "max_slew": null,
      "fluence_weight": 0.0,
      "slew_weight": 0.0
    },
    "optimization": {
      "seeds": [
        0,
        1,
        2,
        3,
        4,
        5,
        6,
        7
      ],
      "frequencies": 20,
      "frequency_range": [
        0.05,
        3.0
      ],
      "crab_intervals": 500,
      "crab_max_evaluations": 1500,
      "grape_max_iterations": 300,
      "grape_max_evaluations": 3000,
      "grape_stop_probability": 0.99995,
      "refine_top": null,
      "workers": 8,
      "blas_threads": 1,
      "ftol": 1e-14,
      "gtol": 1e-10,
      "objective": "root",
      "objective_scale": 1.0,
      "root_epsilon": 1e-12,
      "crab_initial_std": 0.1,
      "warm_starts": []
    },
    "validation": {
      "dimension_increment": 20,
      "trajectory_points": 601,
      "atol": 1e-12,
      "rtol": 1e-12,
      "fidelity_tolerance": 0.0001,
      "truncation_tolerance": 1e-05,
      "edge_tolerance": 1e-05,
      "edge_levels": 5,
      "hold_time": 10.471975511965978,
      "phase_grid_points": 161,
      "hold_points": 401,
      "spectral_threshold": 3.0
    },
    "factor_taus": 20,
    "tau_s_coupling": 0.3,
    "initial_state": "bare",
    "parity_reduction": true,
    "target_probability_goal": 0.99
  },
  "pilot": {
    "enabled": false,
    "cases": [
      "1q",
      "2q_independent"
    ],
    "target": {
      "kind": "fock",
      "value": 10
    },
    "factor_taus": 20,
    "filter_cutoff": 3.0,
    "seeds": [
      100,
      101
    ],
    "profiles": [
      {
        "name": "probability_std0.1",
        "optimization": {
          "objective": "probability",
          "crab_initial_std": 0.1,
          "ftol": 1e-14,
          "gtol": 1e-10
        }
      },
      {
        "name": "probability_std0.3",
        "optimization": {
          "objective": "probability",
          "crab_initial_std": 0.3,
          "ftol": 1e-14,
          "gtol": 1e-10
        }
      },
      {
        "name": "root_std0.1",
        "optimization": {
          "objective": "root",
          "crab_initial_std": 0.1,
          "ftol": 1e-14,
          "gtol": 1e-10
        }
      },
      {
        "name": "root_std0.3",
        "optimization": {
          "objective": "root",
          "crab_initial_std": 0.3,
          "ftol": 1e-14,
          "gtol": 1e-10
        }
      }
    ],
    "budgets": {
      "crab_max_evaluations": 1200,
      "grape_max_iterations": 80,
      "grape_max_evaluations": 800
    },
    "minimum_probability_gain": 1e-06
  },
  "blocks": [
    // =========================================================================
    // 1. SCANSIONE SULLA FREQUENZA DI TAGLIO DEL FILTRO (filter_cutoff)
    //    (I punti cutoff = 3.0 e null a T = 10*tau_s sono già presenti nella
    //    campagna intermedia; qui esploriamo le soglie critiche intermedie).
    // =========================================================================
    {
      "name": "fock6_t10_cutoff_scan",
      "dimension": 60,
      "targets": [
        {
          "kind": "fock",
          "value": 6
        }
      ],
      "factors_taus": [
        10
      ],
      "cutoffs": [
        1.0,
        1.5,
        2.0,
        4.5,
        6.0
      ]
    },
    {
      "name": "fock10_t10_cutoff_scan",
      "dimension": 60,
      "targets": [
        {
          "kind": "fock",
          "value": 10
        }
      ],
      "factors_taus": [
        10
      ],
      "cutoffs": [
        4.0,
        5.0,
        6.5,
        8.0
      ]
    },
    {
      "name": "fock10_t15_cutoff_scan",
      "dimension": 60,
      "targets": [
        {
          "kind": "fock",
          "value": 10
        }
      ],
      "factors_taus": [
        15
      ],
      "cutoffs": [
        1.5,
        2.0,
        4.5,
        null
      ]
    },
    {
      "name": "cat2_t10_cutoff_scan",
      "dimension": 48,
      "targets": [
        {
          "kind": "cat",
          "value": 2.0
        }
      ],
      "factors_taus": [
        10
      ],
      "cutoffs": [
        1.0,
        1.5,
        2.0,
        4.5,
        6.0
      ]
    },

    // =========================================================================
    // 2. RESTRIZIONE DELL'ESCURSIONE DI AMPIEZZA (total_frequency_bounds)
    //    Attorno a omega_q,bare = 2.0*omega_c (con filtro causale omega_cut = 3.0):
    //    - [1.0, 3.0]   -> delta in [-1.0, +1.0]*omega_c (tocca appena omega_c = 1.0)
    //    - [1.25, 2.75] -> delta in [-0.75, +0.75]*omega_c (resta sopra omega_c)
    //    - [1.5, 2.5]   -> delta in [-0.5, +0.5]*omega_c (modulazione stretta +-25%)
    // =========================================================================
    {
      "name": "fock6_t10_bounds_scan",
      "dimension": 60,
      "targets": [
        {
          "kind": "fock",
          "value": 6
        }
      ],
      "factors_taus": [
        10
      ],
      "cutoffs": [
        3.0
      ],
      "controls": [
        {
          "total_frequency_bounds": [
            1.0,
            3.0
          ]
        },
        {
          "total_frequency_bounds": [
            1.25,
            2.75
          ]
        },
        {
          "total_frequency_bounds": [
            1.5,
            2.5
          ]
        }
      ]
    },
    {
      "name": "fock10_t15_bounds_scan",
      "dimension": 60,
      "targets": [
        {
          "kind": "fock",
          "value": 10
        }
      ],
      "factors_taus": [
        15
      ],
      "cutoffs": [
        3.0
      ],
      "controls": [
        {
          "total_frequency_bounds": [
            1.0,
            3.0
          ]
        },
        {
          "total_frequency_bounds": [
            1.25,
            2.75
          ]
        },
        {
          "total_frequency_bounds": [
            1.5,
            2.5
          ]
        }
      ]
    },
    {
      "name": "cat2_t10_bounds_scan",
      "dimension": 48,
      "targets": [
        {
          "kind": "cat",
          "value": 2.0
        }
      ],
      "factors_taus": [
        10
      ],
      "cutoffs": [
        3.0
      ],
      "controls": [
        {
          "total_frequency_bounds": [
            1.0,
            3.0
          ]
        },
        {
          "total_frequency_bounds": [
            1.25,
            2.75
          ]
        },
        {
          "total_frequency_bounds": [
            1.5,
            2.5
          ]
        }
      ]
    },

    // =========================================================================
    // 3. SCANSIONE SULLO SLEW RATE (slew_weight morbido vs max_slew rigido)
    //    Con filtro causale omega_cut = 3.0 e bounds standard [0.5, 3.0].
    // =========================================================================
    {
      "name": "fock6_t10_slew_scan",
      "dimension": 60,
      "targets": [
        {
          "kind": "fock",
          "value": 6
        }
      ],
      "factors_taus": [
        10
      ],
      "cutoffs": [
        3.0
      ],
      "controls": [
        {
          "slew_weight": 0.0001
        },
        {
          "slew_weight": 0.0005
        },
        {
          "slew_weight": 0.002
        },
        {
          "max_slew": 2.5
        },
        {
          "max_slew": 1.5
        }
      ]
    },
    {
      "name": "fock10_t15_slew_scan",
      "dimension": 60,
      "targets": [
        {
          "kind": "fock",
          "value": 10
        }
      ],
      "factors_taus": [
        15
      ],
      "cutoffs": [
        3.0
      ],
      "controls": [
        {
          "slew_weight": 0.0001
        },
        {
          "slew_weight": 0.0005
        },
        {
          "slew_weight": 0.002
        },
        {
          "max_slew": 2.5
        },
        {
          "max_slew": 1.5
        }
      ]
    },

    // =========================================================================
    // 4. ANALISI DELLO STATO INIZIALE VESTITO ("initial_state": "ground")
    //    Preparazione a partire dal vero stato fondamentale interagente |E_0>
    //    dell'Hamiltoniana di Rabi in regime USC (g = 0.3*omega_c) anziché da |0,g,...>.
    // =========================================================================
    {
      "name": "ground_init_fock6",
      "dimension": 60,
      "initial_state": "ground",
      "targets": [
        {
          "kind": "fock",
          "value": 6
        }
      ],
      "factors_taus": [
        10,
        20
      ],
      "cutoffs": [
        3.0
      ]
    },
    {
      "name": "ground_init_fock10",
      "dimension": 60,
      "initial_state": "ground",
      "targets": [
        {
          "kind": "fock",
          "value": 10
        }
      ],
      "factors_taus": [
        10,
        15,
        20
      ],
      "cutoffs": [
        3.0
      ]
    },
    {
      "name": "ground_init_cat2",
      "dimension": 48,
      "initial_state": "ground",
      "targets": [
        {
          "kind": "cat",
          "value": 2.0
        }
      ],
      "factors_taus": [
        10,
        15
      ],
      "cutoffs": [
        3.0
      ]
    }
  ]
}
